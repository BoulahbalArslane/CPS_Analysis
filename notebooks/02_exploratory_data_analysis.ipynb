# 02. Exploratory Data Analysis & Regional Vulnerability
Here we visualize the distributions of global and local CPS across cohorts and analyze regional vulnerability differences across brain regions in Travaglini et al. (2026).


import sys
import os
import pandas as pd

sys.path.append(os.path.abspath(os.path.join('..', 'src')))
from data_loader import SEAADDataLoader
from visualization import CPSVisualizer

loader = SEAADDataLoader("../data/sea-ad_global_and_local_cps_050126.xlsx")
datasets = loader.load_all_sheets()

viz = CPSVisualizer(output_dir="../outputs/figures")
viz.plot_study_comparison(datasets)

if 'Travaglini 2026' in datasets:
    viz.plot_travaglini_regional_breakdown(datasets['Travaglini 2026'])

print("EDA plots generated successfully.")
