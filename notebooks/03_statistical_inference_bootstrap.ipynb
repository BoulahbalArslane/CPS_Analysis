# 03. Statistical Inference & Bootstrap 95% Confidence Intervals
This notebook executes non-parametric hypothesis testing (Wilcoxon / Mann-Whitney U tests) and calculates bias-corrected bootstrap 95% confidence intervals for median differences.


import sys
import os
import numpy as np
import pandas as pd

sys.path.append(os.path.abspath(os.path.join('..', 'src')))
from data_loader import SEAADDataLoader
from stats import CPSStatistics

loader = SEAADDataLoader("../data/sea-ad_global_and_local_cps_050126.xlsx")
datasets = loader.load_all_sheets()

# Example: Bootstrap 95% CI for Travaglini Global CPS
trav_df = datasets['Travaglini 2026']
cps_vals = trav_df['CPS_Global'].dropna().values

median, ci_lower, ci_upper = CPSStatistics.bootstrap_median_ci(cps_vals, n_iterations=1000)
print(f"Travaglini CPS_Global Median: {median:.4f}")
print(f"Bootstrap 95% CI: [{ci_lower:.4f}, {ci_upper:.4f}]")

# Example: Wilcoxon test comparing global vs local ABeta
stat, p_val = CPSStatistics.perform_wilcoxon_test(
    trav_df['CPS_Global_ABeta'].values, 
    trav_df['CPS_Local_ABeta'].values, 
    paired=True
)
print(f"Wilcoxon Paired Test (Global ABeta vs Local ABeta) - Stat: {stat:.2f}, p-value: {p_val:.4e}")
